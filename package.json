{
  "name": "playwrightframework",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:ui": "npx playwright test --ui",
    "test:smoke": "npx playwright test --project smoke",
    "test:failed": "npx playwright test --last-failed --update-snapshots",
    "test:auth": "npx playwright codegen --save-storage=fixtures/auth.json",
    "cli:show": "playwright-cli show",
    "cli:show:annotate": "playwright-cli show --annotate",
    "cli:show:port": "playwright-cli show --port 9323",
    "cli:show:kill": "playwright-cli show --kill",
    "eval:skill": "node evals/run-evals.mjs",
    "eval:skill:with-transcript": "node evals/run-evals.mjs",
    "prepare": "husky install"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.10.2",
    "husky": "^9.0.7",
    "pw-api-plugin": "^2.1.0"
  },
  "dependencies": {
    "dotenv": "^17.0.1",
    "fast-csv": "^5.0.5",
    "zod": "^4.1.12"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}
